{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vivi911.github.io/inkbrush-motion-skill/references/storyboard.schema.json",
  "title": "InkBrush Motion Storyboard",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "title", "summary", "aspectRatio", "width", "height", "fps", "previewSeconds", "finalHoldFrames", "safeMarginPercent", "styleRecipe", "textMode", "brushMode", "beats"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": "1.0"},
    "status": {"enum": ["PLAN_ONLY", "STATIC_REVIEW_READY", "MOTION_PROOF_READY", "RENDERER_REQUIRED", "HOLD"]},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "aspectRatio": {"const": "9:16"},
    "width": {"enum": [720, 1080]},
    "height": {"enum": [1280, 1920]},
    "fps": {"const": 30},
    "previewSeconds": {"type": "number", "minimum": 6, "maximum": 10},
    "finalHoldFrames": {"type": "integer", "minimum": 33},
    "safeMarginPercent": {"type": "number", "minimum": 8, "maximum": 15},
    "styleRecipe": {"enum": ["shan-shui-scroll", "minimal-calligraphy", "seal-diagram"]},
    "textMode": {"const": "code-native"},
    "brushMode": {"enum": ["none", "brush-only", "real-hand-nine-action"]},
    "realHandProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "brushAngleRange", "armEntry", "cropBoundary", "sleeveStyle", "actions", "inkPhysics"],
      "properties": {
        "profile": {"const": "gray-linen-xuan"},
        "brushAngleRange": {"const": [80, 85]},
        "armEntry": {"enum": ["right", "lower-right"]},
        "cropBoundary": {"const": "fabric-only"},
        "sleeveStyle": {"enum": ["gray-linen", "project-defined"]},
        "actions": {"const": ["hover", "touch", "press", "travel", "turn", "lift", "return", "finish", "leave"]},
        "inkPhysics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["paper", "freshCoreOpacity", "wetEdgeOpacity", "dryTrailOpacity", "dryBrushGapPercent", "dryingDelayFrames", "diffusionDelayFrames"],
          "properties": {
            "paper": {"const": "xuan"},
            "freshCoreOpacity": {"type": "number", "minimum": 0.7, "maximum": 0.85},
            "wetEdgeOpacity": {"type": "number", "minimum": 0.15, "maximum": 0.25},
            "dryTrailOpacity": {"type": "number", "minimum": 0.35, "maximum": 0.5},
            "dryBrushGapPercent": {"type": "number", "minimum": 15, "maximum": 35},
            "dryingDelayFrames": {"type": "integer", "minimum": 12, "maximum": 24},
            "diffusionDelayFrames": {"type": "integer", "minimum": 2, "maximum": 6}
          }
        }
      }
    },
    "staticArtifact": {"type": "string", "pattern": "\\.svg$"},
    "staticArtifactSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "beats": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "copy", "startSecond", "endSecond"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "label": {"type": "string", "minLength": 1},
          "copy": {"type": "string", "minLength": 1},
          "zhLabel": {"type": "string", "minLength": 1},
          "startSecond": {"type": "number", "minimum": 0},
          "endSecond": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "motionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rendererLane", "rendererOwner", "reviewer", "staticApprovalSha256", "frames"],
      "properties": {
        "rendererLane": {"enum": ["svg-js", "gsap-svg", "remotion-svg", "after-effects"]},
        "rendererOwner": {"type": "string", "minLength": 1},
        "reviewer": {"type": "string", "minLength": 1},
        "staticApprovalSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "nineActionProof": {"type": "string", "pattern": "\\.png$"},
        "nineActionProofSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "frames": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "frame", "path", "sha256"],
            "properties": {
              "role": {"enum": ["start", "middle", "end"]},
              "frame": {"type": "integer", "minimum": 0},
              "path": {"type": "string", "pattern": "\\.png$"},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "oneOf": [
        {"properties": {"width": {"const": 720}, "height": {"const": 1280}}},
        {"properties": {"width": {"const": 1080}, "height": {"const": 1920}}}
      ]
    },
    {
      "if": {"properties": {"status": {"enum": ["MOTION_PROOF_READY", "RENDERER_REQUIRED", "STATIC_REVIEW_READY"]}}},
      "then": {"required": ["staticArtifact", "staticArtifactSha256"]}
    },
    {
      "if": {"properties": {"status": {"const": "MOTION_PROOF_READY"}}},
      "then": {"required": ["motionEvidence"]},
      "else": {"not": {"required": ["motionEvidence"]}}
    },
    {
      "if": {"properties": {"status": {"const": "PLAN_ONLY"}}},
      "then": {"not": {"anyOf": [{"required": ["staticArtifact"]}, {"required": ["staticArtifactSha256"]}]}}
    },
    {
      "if": {"properties": {"brushMode": {"const": "real-hand-nine-action"}}, "required": ["brushMode"]},
      "then": {"required": ["realHandProfile"]},
      "else": {"not": {"required": ["realHandProfile"]}}
    },
    {
      "if": {
        "properties": {"status": {"const": "MOTION_PROOF_READY"}, "brushMode": {"const": "real-hand-nine-action"}},
        "required": ["status", "brushMode"]
      },
      "then": {"properties": {"motionEvidence": {"required": ["nineActionProof", "nineActionProofSha256"]}}}
    }
  ]
}
